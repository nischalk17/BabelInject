{
  "name": "aie-results-explorer",
  "private": true,
  "version": "0.0.0",
  "description": "Static, read-only explorer for the BabelInject results (data from results/ via analysis/export_demo_data.py)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "capture": "node scripts/capture.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "frames": "node scripts/replay-frames.mjs"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "22.12.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
