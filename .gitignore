.venv/

# secrets: never commit API keys
.env
.env.*
!.env.example

# local AI-tooling files
CLAUDE.md
.claude/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/
dist/
*.egg-info/

# raw results are gitignored; only summary CSVs are committed
results/*
!results/.gitkeep
!results/summary/
results/summary/*
!results/summary/*.csv
# follow-up studies (summary_quiet, summary_control, ...): CSV tables only, like results/summary
!results/summary_*/
results/summary_*/*
!results/summary_*/*.csv

node_modules/

# local planning docs (kept on disk, not published)
docs/PROJECT_PLAN.md
docs/READING_GUIDE.md
docs/SCHEDULE.md

# generated report HTML (the PDF and Markdown are committed)
report/report.html
